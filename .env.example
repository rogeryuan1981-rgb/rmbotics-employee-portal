# Browser only: Supabase publishable/anon key. Never put service keys in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Separate server/worker environment, not bundled into the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MAIL_MODE=sink
MAIL_SINK_DIR=./work/mail
PORTAL_URL=http://127.0.0.1:5173/
MAIL_FROM=
RESEND_API_KEY=
ALLOW_REAL_MAIL=false
